# Credentials and machine-local configuration
.env
.env.*
!.env.example
.npmrc
.pypirc
.netrc
secrets/
.secrets/
*.pem
*.key
*.p12
*.pfx

# Private study library, evidence, owner decisions, and archived versions
/transcript/*
!/transcript/.gitkeep
/summarize/*
