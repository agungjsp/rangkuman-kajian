---
import '../styles/global.css';
import { csrfToken } from '../lib/server';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={csrfToken} />
    <meta name="description" content="Catatan kajian pribadi dengan tautan sumber, referensi, dan ruang untuk belajar kembali." />
    <title>{title} · Rangkuman Kajian</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Langsung ke isi</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Rangkuman Kajian, perpustakaan">
        <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 5v15M12 5C9 3 5 3 2 4v15c3-1 7-1 10 1 3-2 7-2 10-1V4c-3-1-7-1-10 1Z" /></svg>
        Rangkuman Kajian
      </a>
      <div class="header-actions"><span class="header-note">Ruang belajar pribadi</span><nav aria-label="Navigasi utama"><a href="/kelola/">Kelola rangkuman</a><a href="/tinjauan/">Tinjauan JEV</a></nav></div>
    </header>
    <slot />
    <footer class="site-footer"><span>Belajar, meninjau, mengamalkan.</span><span>Catatan pribadi · Tinjauan manusia tetap diperlukan</span></footer>
  </body>
</html>
